# Nginx 配置示例
# 用于晨翼Agent 自动更新服务

# 在 /etc/nginx/sites-available/oneapi.xintiandi.online 中添加以下配置

server {
    listen 443 ssl http2;
    server_name oneapi.xintiandi.online;
    
    # SSL 证书配置（使用 Let's Encrypt）
    ssl_certificate /etc/letsencrypt/live/oneapi.xintiandi.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/oneapi.xintiandi.online/privkey.pem;
    
    # 其他 SSL 配置
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    
    # 晨翼Agent 更新服务
    location /chenyi-agent/ {
        alias /var/www/chenyi-agent/;
        
        # 启用目录浏览（可选）
        autoindex on;
        autoindex_exact_size off;
        autoindex_localtime on;
        
        # CORS 配置（允许 APP 访问）
        add_header Access-Control-Allow-Origin *;
        add_header Access-Control-Allow-Methods 'GET, OPTIONS';
        add_header Access-Control-Allow-Headers 'Range';
        
        # 缓存配置
        expires 1h;
        add_header Cache-Control "public, immutable";
        
        # 大文件支持（APK 下载）
        client_max_body_size 100M;
        
        # 日志
        access_log /var/log/nginx/chenyi-agent-access.log;
        error_log /var/log/nginx/chenyi-agent-error.log;
    }
    
    # 其他 API 路由
    location / {
        # 其他服务配置
        proxy_pass http://localhost:3000;
    }
}

# HTTP 重定向到 HTTPS
server {
    listen 80;
    server_name oneapi.xintiandi.online;
    
    location / {
        return 301 https://$server_name$request_uri;
    }
}
